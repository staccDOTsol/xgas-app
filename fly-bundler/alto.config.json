{
  "port": 4337,
  "chain-type": "arbitrum",
  "safe-mode": false,
  "deploy-simulations-contract": false,
  "code-override-support": true,
  "balance-override": true,
  "block-time": 500,
  "max-gas-per-user-op": "30000000",
  "max-gas-per-bundle": "30000000",
  "arbitrum-base-fee-multiplier": "150",
  "floor-max-fee-per-gas": "0.1",
  "ceiling-max-priority-fee-per-gas": "0.001",
  "refilling-wallets": true,
  "min-executor-balance": "20000000000000000",
  "executor-refill-interval": 300,
  "flush-stuck-transactions-during-startup": true,
  "expiration-check": true,
  "enable-cors": true,
  "enable-debug-endpoints": false,
  "rpc-methods": "eth_chainId,eth_supportedEntryPoints,eth_estimateUserOperationGas,eth_sendUserOperation,eth_getUserOperationByHash,eth_getUserOperationReceipt,pimlico_getUserOperationGasPrice,pimlico_getUserOperationStatus",
  "json": true,
  "log-level": "info",
  "public-client-log-level": "error",
  "wallet-client-log-level": "error"
}
